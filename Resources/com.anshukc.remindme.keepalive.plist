<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Launch agent that starts Remind Me at login and restarts it if it
         crashes. A normal Quit exits cleanly (status 0), so launchd leaves
         it alone. -->
    <key>Label</key>
    <string>com.anshukc.remindme.keepalive</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/RemindMe</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
